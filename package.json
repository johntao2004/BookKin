{
  "name": "silvae",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "docker:up": "bash docker/deploy.sh",
    "docker:build": "bash docker/deploy.sh --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev": "pnpm build:ming-library && pnpm --filter @silvae/web dev",
    "build": "pnpm generate:tokens && pnpm build:ming-library && pnpm --filter @silvae/web build",
    "build:ming-library": "pnpm --filter @silvae/ming-library build",
    "test": "pnpm --filter @silvae/web test",
    "lint": "pnpm --filter @silvae/web lint",
    "typecheck": "pnpm --filter @silvae/web typecheck",
    "generate:tokens": "node scripts/generate-design-tokens.mjs",
    "generate:client": "./apps/server/mvnw -f apps/server/pom.xml -Pgenerate-client generate-sources",
    "check:tokens": "node scripts/generate-design-tokens.mjs --check",
    "demo:library": "node scripts/create-demo-library.mjs",
    "demo:library:stress": "node scripts/create-demo-library.mjs --stress-count=120",
    "demo:seed": "bash scripts/seed-native-demo.sh",
    "start:local": "bash scripts/start-local.sh",
    "stop:local": "bash scripts/stop-local.sh",
    "benchmark:catalog": "node scripts/benchmark/benchmark-catalog.mjs",
    "start:preview": "node scripts/local-preview.mjs start",
    "status:preview": "node scripts/local-preview.mjs status",
    "stop:preview": "node scripts/local-preview.mjs stop"
  },
  "devDependencies": {
    "meshoptimizer": "1.1.1"
  }
}
