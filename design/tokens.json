{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "BookKin设计 Token",
    "version": "1.0.0",
    "baseUnit": 4
  },
  "color": {
    "primitive": {
      "cream050": "#FFFDF8",
      "cream100": "#FAF7F0",
      "cream200": "#F4EEE3",
      "cream300": "#E9DECF",
      "ink900": "#191816",
      "ink800": "#26231F",
      "ink700": "#3F3A34",
      "ink500": "#756F66",
      "ink300": "#AAA297",
      "coral600": "#C56F4E",
      "coral700": "#9F4F38",
      "coral100": "#F4DED5",
      "teal600": "#39867A",
      "teal500": "#5A9F91",
      "amber600": "#B87920",
      "red600": "#B84A45",
      "green600": "#4F7B55",
      "highlightYellow": "#FFF36D",
      "highlightGreen": "#A7F3A1",
      "highlightPink": "#FFB3D1",
      "highlightBlue": "#A9E7FF",
      "highlightOrange": "#FFC47A",
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "semantic": {
      "canvas": "{color.primitive.cream100}",
      "surface": "{color.primitive.cream050}",
      "surfaceSoft": "{color.primitive.cream200}",
      "surfaceStrong": "{color.primitive.cream300}",
      "surfaceDark": "{color.primitive.ink900}",
      "surfaceDarkRaised": "{color.primitive.ink800}",
      "textPrimary": "{color.primitive.ink900}",
      "textSecondary": "{color.primitive.ink700}",
      "textMuted": "{color.primitive.ink500}",
      "textOnDark": "{color.primitive.cream100}",
      "border": "{color.primitive.cream300}",
      "borderStrong": "{color.primitive.ink300}",
      "primary": "{color.primitive.coral600}",
      "primaryHover": "{color.primitive.coral700}",
      "primarySoft": "{color.primitive.coral100}",
      "focus": "{color.primitive.teal600}",
      "success": "{color.primitive.green600}",
      "warning": "{color.primitive.amber600}",
      "error": "{color.primitive.red600}"
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "radius": {
    "none": 0,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "2xl": 24,
    "pill": 9999
  },
  "typography": {
    "fontFamily": {
      "display": "Noto Serif SC, Source Han Serif SC, Songti SC, serif",
      "body": "Inter, Noto Sans SC, PingFang SC, system-ui, sans-serif",
      "readerSerif": "Noto Serif SC, Source Han Serif SC, Songti SC, serif",
      "readerSans": "Noto Sans SC, Source Han Sans SC, PingFang SC, system-ui, sans-serif",
      "mono": "JetBrains Mono, SFMono-Regular, monospace"
    },
    "fontSize": {
      "caption": 12,
      "bodySm": 14,
      "body": 16,
      "titleSm": 18,
      "title": 22,
      "headingSm": 28,
      "heading": 36,
      "display": 48,
      "displayLg": 60
    },
    "lineHeight": {
      "tight": 1.15,
      "heading": 1.25,
      "body": 1.65,
      "ui": 1.4
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "shadow": {
    "focus": "0 0 0 3px rgba(57, 134, 122, 0.22)",
    "cover": "0 12px 28px rgba(25, 24, 22, 0.16)",
    "popover": "0 18px 48px rgba(25, 24, 22, 0.14)"
  },
  "layout": {
    "contentMax": 1360,
    "readingMax": 760,
    "navHeight": 72,
    "touchTarget": 44,
    "breakpointMobile": 600,
    "breakpointTablet": 1024,
    "breakpointDesktop": 1440,
    "readerPageGap": 32,
    "readerPagePadding": 48,
    "readerViewportBottom": 24,
    "readerControlHeight": 56,
    "readerColumnLimit": 20
  }
}
