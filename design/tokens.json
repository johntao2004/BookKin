{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "BookKin设计 Token",
    "version": "1.0.0",
    "baseUnit": 4
  },
  "color": {
    "primitive": {
      "cream050": "#FFFDF8",
      "cream100": "#FAF9F5",
      "cream200": "#F5F0E8",
      "cream300": "#E8E0D2",
      "creamCard": "#EFE9DE",
      "ink900": "#141413",
      "ink850": "#1F1E1B",
      "ink800": "#252523",
      "ink700": "#3D3D3A",
      "ink500": "#6C6A64",
      "ink400": "#A09D96",
      "ink300": "#8E8B82",
      "coral600": "#CC785C",
      "coral700": "#A9583E",
      "coral100": "#F4DED5",
      "teal600": "#5DB8A6",
      "teal500": "#5DB8A6",
      "amber600": "#E8A55A",
      "amberWarning": "#D4A017",
      "red600": "#C64545",
      "green600": "#5DB872",
      "hairline": "#E6DFD8",
      "hairlineSoft": "#EBE6DF",
      "highlightYellow": "#FFF36D",
      "highlightGreen": "#A7F3A1",
      "highlightPink": "#FFB3D1",
      "highlightBlue": "#A9E7FF",
      "highlightOrange": "#FFC47A",
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "semantic": {
      "canvas": "{color.primitive.cream100}",
      "surface": "{color.primitive.creamCard}",
      "surfaceCard": "{color.primitive.creamCard}",
      "surfaceSoft": "{color.primitive.cream200}",
      "surfaceStrong": "{color.primitive.cream300}",
      "surfaceCreamStrong": "{color.primitive.cream300}",
      "surfaceDark": "{color.primitive.ink900}",
      "surfaceDarkRaised": "{color.primitive.ink800}",
      "surfaceDarkSoft": "{color.primitive.ink850}",
      "textPrimary": "{color.primitive.ink900}",
      "bodyStrong": "{color.primitive.ink800}",
      "textSecondary": "{color.primitive.ink700}",
      "textMuted": "{color.primitive.ink500}",
      "textMutedSoft": "{color.primitive.ink300}",
      "textOnDark": "{color.primitive.cream100}",
      "textOnDarkSoft": "{color.primitive.ink400}",
      "textOnPrimary": "{color.primitive.white}",
      "border": "{color.primitive.hairline}",
      "borderSoft": "{color.primitive.hairlineSoft}",
      "borderStrong": "{color.primitive.ink300}",
      "primary": "{color.primitive.coral600}",
      "primaryHover": "{color.primitive.coral700}",
      "primarySoft": "{color.primitive.coral100}",
      "primaryDisabled": "{color.primitive.hairline}",
      "accentTeal": "{color.primitive.teal600}",
      "accentAmber": "{color.primitive.amber600}",
      "focus": "{color.primitive.coral600}",
      "success": "{color.primitive.green600}",
      "warning": "{color.primitive.amberWarning}",
      "error": "{color.primitive.red600}"
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96,
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "section": 96
  },
  "radius": {
    "none": 0,
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "2xl": 24,
    "pill": 9999,
    "full": 9999
  },
  "typography": {
    "fontFamily": {
      "display": "Noto Serif SC, Source Han Serif SC, Songti SC, serif",
      "body": "Inter, Noto Sans SC, PingFang SC, system-ui, sans-serif",
      "readerSerif": "Noto Serif SC, Source Han Serif SC, Songti SC, serif",
      "readerSans": "Noto Sans SC, Source Han Sans SC, PingFang SC, system-ui, sans-serif",
      "mono": "JetBrains Mono, SFMono-Regular, monospace"
    },
    "fontSize": {
      "caption": 13,
      "captionUppercase": 12,
      "bodySm": 14,
      "body": 16,
      "titleSm": 18,
      "title": 22,
      "label": 16,
      "headingSm": 28,
      "heading": 36,
      "display": 48,
      "displayLg": 64,
      "code": 14,
      "button": 14,
      "navLink": 14
    },
    "lineHeight": {
      "tight": 1.05,
      "displayLg": 1.1,
      "displayMd": 1.15,
      "displaySm": 1.2,
      "heading": 1.15,
      "body": 1.55,
      "ui": 1.4,
      "titleLg": 1.3,
      "titleMd": 1.4,
      "titleSm": 1.4,
      "caption": 1.4,
      "code": 1.6,
      "button": 1,
      "navLink": 1.4
    },
    "letterSpacing": {
      "displayXl": "-1.5px",
      "displayLg": "-1px",
      "displayMd": "-0.5px",
      "displaySm": "-0.3px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "shadow": {
    "focus": "0 0 0 3px rgba(204, 120, 92, 0.18)",
    "cover": "0 1px 3px rgba(20, 20, 19, 0.08)",
    "popover": "0 8px 24px rgba(20, 20, 19, 0.12)"
  },
  "layout": {
    "contentMax": 1200,
    "readingMax": 760,
    "navHeight": 64,
    "touchTarget": 44,
    "controlHeight": 40,
    "iconButtonSize": 36,
    "inputPaddingInline": 14,
    "inputPaddingBlock": 10,
    "breakpointMobile": 768,
    "breakpointTablet": 1024,
    "breakpointDesktop": 1440,
    "readerPageGap": 32,
    "readerPagePadding": 48,
    "readerViewportBottom": 24,
    "readerControlHeight": 56,
    "readerColumnLimit": 20
  }
}
