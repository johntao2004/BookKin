POSTGRES_DB=silvae
POSTGRES_USER=silvae
POSTGRES_PASSWORD=change-me-before-production
SILVAE_SESSION_COOKIE_SECURE=false
SILVAE_PUBLIC_BASE_URL=http://localhost:8080
# 留空时容器会在持久化数据卷中自动生成并复用 256 位随机密钥；生产环境也可手动指定（openssl rand -hex 32）。
SILVAE_AI_SETTINGS_ENCRYPTION_KEY=
SILVAE_TWO_FACTOR_ENCRYPTION_KEY=
SILVAE_HTTP_PORT=8080
SILVAE_LIBRARY_NAME=主书库
SILVAE_LIBRARY_MAIN=./data/library
# 多根目录备份时按 Compose 挂载顺序用冒号分隔；恢复时必须保持同一顺序。
SILVAE_LIBRARY_BACKUP_ROOTS=./data/library
SILVAE_BACKUP_DIR=./data/backups
# 上传文件使用流式写入；以下均可在 NAS 部署时调整。
SILVAE_UPLOAD_MAX_FILE_SIZE=2147483648
SILVAE_UPLOAD_MAX_BATCH_FILES=20
SILVAE_UPLOAD_RETENTION=24h
SILVAE_UPLOAD_MAX_COVER_SIZE=20974520
# Open Library 默认开启；Google Books 只在配置 API Key 后调用。
SILVAE_METADATA_OPEN_LIBRARY_ENABLED=true
SILVAE_METADATA_GOOGLE_API_KEY=
SILVAE_UID=1000
SILVAE_GID=1000
TZ=Asia/Shanghai
