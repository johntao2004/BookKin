POSTGRES_DB=bookkin
POSTGRES_USER=bookkin
POSTGRES_PASSWORD=change-me-before-production
BOOKKIN_SESSION_COOKIE_SECURE=false
BOOKKIN_PUBLIC_BASE_URL=http://localhost:8080
# Optional while AI is disabled; required before enabling/saving AI provider keys.
# Generate a stable random value for production (for example: openssl rand -hex 32).
BOOKKIN_AI_SETTINGS_ENCRYPTION_KEY=
BOOKKIN_HTTP_PORT=8080
BOOKKIN_LIBRARY_NAME=主书库
BOOKKIN_LIBRARY_MAIN=./.local/library
BOOKKIN_FONT_STORAGE=./.local/fonts
# 多根目录备份时按 Compose 挂载顺序用冒号分隔；恢复时必须保持同一顺序。
BOOKKIN_LIBRARY_BACKUP_ROOTS=./.local/library
BOOKKIN_BACKUP_DIR=./.local/backups
# 上传文件使用流式写入；以下均可在 NAS 部署时调整。
BOOKKIN_UPLOAD_MAX_FILE_SIZE=2147483648
BOOKKIN_UPLOAD_MAX_BATCH_FILES=20
BOOKKIN_UPLOAD_RETENTION=24h
BOOKKIN_UPLOAD_MAX_COVER_SIZE=20971520
# Open Library 默认开启；Google Books 只在配置 API Key 后调用。
BOOKKIN_METADATA_OPEN_LIBRARY_ENABLED=true
BOOKKIN_METADATA_GOOGLE_API_KEY=
BOOKKIN_UID=1000
BOOKKIN_GID=1000
TZ=Asia/Shanghai
