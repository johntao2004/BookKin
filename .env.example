POSTGRES_DB=silvae
POSTGRES_USER=silvae
POSTGRES_PASSWORD=change-me-before-production
SILVAE_SESSION_COOKIE_SECURE=false
SILVAE_PUBLIC_BASE_URL=http://localhost:8080
# Optional while AI is disabled; required before enabling/saving AI provider keys.
# Generate a stable random value for production (for example: openssl rand -hex 32).
SILVAE_AI_SETTINGS_ENCRYPTION_KEY=
# Required before enabling the restricted vault; keep stable and back up separately.
SILVAE_TWO_FACTOR_ENCRYPTION_KEY=
SILVAE_HTTP_PORT=8080
SILVAE_LIBRARY_NAME=主书库
SILVAE_LIBRARY_MAIN=./.local/library
SILVAE_FONT_STORAGE=./.local/fonts
SILVAE_ARTICLE_STORAGE=./.local/content/articles
SILVAE_VAULT_STORAGE=./.local/content/vault
# 多根目录备份时按 Compose 挂载顺序用冒号分隔；恢复时必须保持同一顺序。
SILVAE_LIBRARY_BACKUP_ROOTS=./.local/library
SILVAE_BACKUP_DIR=./.local/backups
# 上传文件使用流式写入；以下均可在 NAS 部署时调整。
SILVAE_UPLOAD_MAX_FILE_SIZE=2147483648
SILVAE_UPLOAD_MAX_BATCH_FILES=20
SILVAE_UPLOAD_RETENTION=24h
SILVAE_UPLOAD_MAX_COVER_SIZE=20971520
# Open Library 默认开启；Google Books 只在配置 API Key 后调用。
SILVAE_METADATA_OPEN_LIBRARY_ENABLED=true
SILVAE_METADATA_GOOGLE_API_KEY=
SILVAE_UID=1000
SILVAE_GID=1000
TZ=Asia/Shanghai
